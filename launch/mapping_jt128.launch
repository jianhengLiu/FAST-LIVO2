<launch>
<!-- Launch file for Hesai JT128 LiDAR -->

	<arg name="rviz" default="true" />

	<rosparam command="load" file="$(find fast_livo)/config/jt128.yaml" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(find fast_livo)/config/camera_fisheye2pinhole.yaml" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>

	<node pkg="image_transport" type="republish" name="republish" args="compressed in:=/camera1/image_raw raw out:=/camera1/image_raw" output="screen" respawn="true"/>
</launch>
